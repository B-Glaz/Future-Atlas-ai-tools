{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "future-atlas-ai-tools-sandbox",
  "main": "custom-worker.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://winaoavaimwkozrlozfw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_3g_OywPXYcr21IQuGaEq2g_SsNFq7Fm",
