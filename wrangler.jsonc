{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "future-atlas-ai-tools",
  "main": "custom-worker.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "build": {
    "command": "npm run cf:build"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "NEXT_PUBLIC_SUPABASE_DIRECT_CONNECTION_STRING": "postgresql://postgres:[Onewindow@123098]@db.qkxrzieifutndosqjzsh.supabase.co:5432/postgres",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XD_r5etqoOV5wP4ldhcYSA_Oajylrfo",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qkxrzieifutndosqjzsh.supabase.co",
    "SUPABASE_CLI_SETUP_COMMANDS": "supabase login supabase init supabase link --project-ref qkxrzieifutndosqjzsh"
  },
}