# AI provider secrets. Keep these server-side only.
# Configure them as Cloudflare Worker secrets in production.
NVIDIA_API_KEY=

# Optional NVIDIA-hosted model override.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_ENABLED=true
# Optional comma-separated kill switch, for example: cost,scholarship
AI_DISABLED_MODES=

# Supabase public browser configuration. Publishable key is safe for clients;
# RLS and server-side user validation protect private data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Required only for verified tenant-domain activation.
SUPABASE_SECRET_KEY=

# Optional forum destination. Falls back to the internal guidance page.
NEXT_PUBLIC_FORUM_URL=

# Comma-separated exact origins allowed to embed /embed.
# Include the scheme and do not include paths.
EMBED_ALLOWED_ORIGINS=https://client.com

# Optional alert recipient metadata for security notifications.
SECURITY_ALERT_EMAIL=

# Optional webhook endpoint that receives unauthorized-embed alerts as JSON.
SECURITY_ALERT_WEBHOOK_URL=

# Optional alert cooldown. Defaults to 3600 seconds.
SECURITY_ALERT_COOLDOWN_SECONDS=3600
