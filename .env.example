# AI provider secret. Keep this server-side only.
# For Cloudflare production, set the same value as the NVIDIA_API_KEY Worker secret.
NVIDIA_API_KEY=

# Optional NVIDIA-hosted model override.
NVIDIA_MODEL=openai/gpt-oss-20b

# Optional forum destination. Falls back to the internal guidance page.
NEXT_PUBLIC_FORUM_URL=

# Comma-separated exact origins allowed to embed /embed.
# Include the scheme and do not include paths.
EMBED_ALLOWED_ORIGINS=https://client.com

# Optional alert recipient metadata for security notifications.
SECURITY_ALERT_EMAIL=

# Optional webhook endpoint that receives unauthorized-embed alerts as JSON.
SECURITY_ALERT_WEBHOOK_URL=

# Optional alert cooldown. Defaults to 3600 seconds.
SECURITY_ALERT_COOLDOWN_SECONDS=3600
