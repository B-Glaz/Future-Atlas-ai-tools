# AI provider secrets. Keep these server-side only.
# Configure them as Cloudflare Worker secrets in production.
NVIDIA_API_KEY=

# Optional NVIDIA-hosted model override.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_ENABLED=true
# Optional comma-separated kill switch, for example: cost,scholarship
AI_DISABLED_MODES=

# Provider routing. First configured provider wins; failures move to the next.
# Generic OpenAI-compatible providers need all four AI_* values.
AI_PROVIDER_ORDER=custom,nvidia,openrouter,openai,deepseek
AI_MAX_PROVIDER_ATTEMPTS=2
AI_PROVIDER_NAME=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Supabase public browser configuration. Publishable key is safe for clients;
# RLS and server-side user validation protect private data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Google OAuth web client ID used by Google Identity Services.
# Keep the Google client secret only in Supabase Auth provider settings.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=508514149239-s8ubgbr7ikf871vc88t3va7r6b7cmca4.apps.googleusercontent.com

# Localhost-only developer login. These values are exposed to the local browser by design.
NEXT_PUBLIC_LOCAL_DEV_USER_NAME=Local Developer
NEXT_PUBLIC_LOCAL_DEV_USER_EMAIL=developer@example.com
NEXT_PUBLIC_LOCAL_DEV_USER_PASSWORD=FutureAtlasDev2026!

# Server-only Supabase secret key. Required only for verified tenant-domain activation.
SUPABASE_SECRET_KEY=

# Optional forum destination. Falls back to the internal guidance page.
NEXT_PUBLIC_FORUM_URL=

# Comma-separated exact origins allowed to embed /embed.
# Include the scheme and do not include paths.
EMBED_ALLOWED_ORIGINS=https://client.com

# Optional alert recipient metadata for security notifications.
SECURITY_ALERT_EMAIL=

# Optional webhook endpoint that receives unauthorized-embed alerts as JSON.
SECURITY_ALERT_WEBHOOK_URL=

# Optional alert cooldown. Defaults to 3600 seconds.
SECURITY_ALERT_COOLDOWN_SECONDS=3600
